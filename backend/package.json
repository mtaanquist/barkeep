{
  "name": "barkeep-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-sql.js",
    "start": "node dist/server.js",
    "init-db": "tsx src/db/init.ts",
    "reset-code": "node dist/cli/reset-code.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "better-sqlite3": "12.2.0",
    "cors": "2.8.5",
    "dotenv": "17.2.0",
    "express": "4.21.2",
    "express-rate-limit": "^8.6.2",
    "multer": "2.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "nodemon": "3.1.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
